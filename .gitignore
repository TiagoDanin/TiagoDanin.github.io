# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# CLAUDE
!CLAUDE.md
!.claude/
.claude/settings.local.json
.claude/**/*.local.json

# testing
/coverage

# next.js
/.next/
/out/
/dist/

# production
/build
/public/rss/blog.xml
/public/rss/projects.xml
/public/rss/talks.xml
/public/rss/timeline.xml
/public/sitemap.xml
/public/sitemap-site.xml
/public/sitemap-site-*.xml
/public/sitemap-project-github.xml
/public/sitemap-homepage-github.xml
/public/llms.txt
/public/llms-full.txt
/public/posts.txt
/public/talks.txt
/public/projects.txt
/public/timeline.txt

# Markdown mirrors written by scripts/generateLlms.ts
/public/*.md
/public/post/
/public/talk/
/public/project/
/public/rankings/
/public/faq/
note.md

# misc
/tmp/
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Impeccable
PRODUCT.md
DESIGN.md
.impeccable/

# Storybook static build
/storybook-static

# Lingui: the .po catalogs are the source, the compiled .ts are build output
src/locales/*/messages.ts
