{
  "name": "tiagodanin-website",
  "version": "3.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "data": "yarn data:rss && yarn data:llms && yarn i18n:compile",
    "build": "yarn data && next build --webpack && tsx scripts/flattenDefaultLocale.ts",
    "start": "next start",
    "lint": "next lint",
    "sitemap": "tsx scripts/generateSitemaps.ts && next-sitemap --config next-sitemap.config.cjs && tsx scripts/annotateSitemapMarkdown.ts",
    "data:github": "tsx scripts/getProjectsGithub.ts",
    "data:npm": "tsx scripts/getProjectsNPM.ts",
    "data:rss": "tsx scripts/generateRss.ts",
    "data:llms": "tsx scripts/generateLlms.ts",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile",
    "deploy": "yarn data:github && yarn build && yarn sitemap && yarn build",
    "storybook": "yarn i18n:compile && storybook dev -p 6006",
    "build-storybook": "yarn i18n:compile && storybook build -o storybook-static"
  },
